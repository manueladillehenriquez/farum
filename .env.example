# =====================================================================
# FARUM · Variables de entorno
#
# Copia este archivo a `.env.local` para desarrollar en tu computador.
# En producción se configuran en Vercel → Settings → Environment Variables.
#
# NUNCA commitees `.env.local` ni pongas valores reales en este archivo:
# `.env.example` solo lleva NOMBRES y valores de prueba públicos.
# =====================================================================

# --- Sitio -----------------------------------------------------------
# URL pública del sitio, sin "/" final. En local: http://localhost:3000
# En producción: https://www.farum.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------
# Supabase → Project Settings → API.
# URL y anon key son PÚBLICAS por diseño (la seguridad la da RLS).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ¡SECRETA! Se salta RLS. Solo servidor. Jamás con prefijo NEXT_PUBLIC_.
# Si alguna vez se filtra: Supabase → Settings → API → rotar la clave.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (anti-bots) --------------------------------
# Cloudflare → Turnstile → Add widget. Estas dos son las claves de PRUEBA
# oficiales de Cloudflare (siempre aprueban): sirven solo para desarrollo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Transbank Webpay Plus -------------------------------------------
# "integration" = sandbox (por defecto): el SDK trae las credenciales de
# prueba, no hace falta nada más y NO se cobra dinero real.
# "production"   = cobros reales: exige las dos variables de abajo.
TRANSBANK_ENV=integration
# Solo en producción (las entrega Transbank al validar tu comercio):
# TRANSBANK_COMMERCE_CODE=
# TRANSBANK_API_KEY=
